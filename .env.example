APP_NAME="Production RAG System for IT and Security Triage"
ENVIRONMENT="development"

EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_STORE_PATH="data/vector_store/faiss.index"
DOCS_PATH="data/docs"

# Optional API key protection.
# Leave blank for open local development.
TRIAGE_API_KEY=

# Optional ML category classifier.
# Set to true only after training a local model artifact.
USE_ML_CLASSIFIER=false
ML_CATEGORY_MODEL_PATH=/app/models/category_classifier.joblib

# Streamlit dashboard API target.
# For Docker Compose, use http://triage-api:8000
# For local Streamlit + local FastAPI, use http://127.0.0.1:8000
API_BASE_URL=http://triage-api:8000